<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Normalization" id="normalization">
    <mxGraphModel dx="100" dy="100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1100" htmlLabel="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:28px;&quot;&gt;Normalization Process&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:18px;&quot;&gt;Alumni Network and Engagement Platform&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="20" width="700" height="60" as="geometry"/></mxCell>
        <mxCell id="unf_alumni" value="&lt;b style=&quot;font-size:14px;&quot;&gt;UNF (Unnormalized)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, FirstName, LastName, Email, &lt;b style=&quot;color:red;&quot;&gt;Phone1, Phone2, Phone3&lt;/b&gt;, Address, GraduationYear, DeptID, BatchID, CompanyID, ...)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:red;&quot;&gt;Problems:&lt;/b&gt;&lt;br&gt;• Repeating group (multiple phones)&lt;br&gt;• Composite attribute (Address)&lt;br&gt;• Derived attributes stored" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="350" height="200" as="geometry"/></mxCell>
        <mxCell id="one_nf_alumni" value="&lt;b style=&quot;font-size:14px;&quot;&gt;1NF (First Normal Form)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, FirstName, LastName, Email, DateOfBirth, Gender, &lt;b&gt;Address_City, Address_State, Address_PinCode&lt;/b&gt;, GraduationYear, DeptID, BatchID, CompanyID, ...)&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI_PHONE&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, &lt;u&gt;PhoneNumber&lt;/u&gt;)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;Fixed:&lt;/b&gt;&lt;br&gt;• Repeating groups → New table&lt;br&gt;• Composite → Decomposed&lt;br&gt;• Derived → Removed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="unf_to_1nf" style="html=1;strokeWidth=2;strokeColor=#000000;endArrow=blockThin;startArrow=none;labelBackgroundColor=none;fontSize=10;fontStyle=1;fontColor=#CC0000;" edge="1" source="unf_alumni" target="one_nf_alumni" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="two_nf_alumni" value="&lt;b style=&quot;font-size:14px;&quot;&gt;2NF (Second Normal Form)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, FirstName, LastName, Email, ...)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ Single attribute PK&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ No partial dependencies&lt;/b&gt;&lt;br&gt;&lt;br&gt;All non-key attributes depend fully on AlumniID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="1nf_to_2nf" style="html=1;strokeWidth=2;strokeColor=#000000;endArrow=blockThin;startArrow=none;labelBackgroundColor=none;fontSize=10;fontStyle=1;fontColor=#CC0000;" edge="1" source="one_nf_alumni" target="two_nf_alumni" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="three_nf_alumni" value="&lt;b style=&quot;font-size:14px;&quot;&gt;3NF (Third Normal Form)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, FirstName, LastName, Email, ...)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ No transitive dependencies&lt;/b&gt;&lt;br&gt;&lt;br&gt;DeptName → DeptID (FK reference)&lt;br&gt;BatchYear → BatchID (FK reference)&lt;br&gt;CompanyName → CompanyID (FK reference)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1230" y="120" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="2nf_to_3nf" style="html=1;strokeWidth=2;strokeColor=#000000;endArrow=blockThin;startArrow=none;labelBackgroundColor=none;fontSize=10;fontStyle=1;fontColor=#CC0000;" edge="1" source="two_nf_alumni" target="three_nf_alumni" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bcnf_alumni" value="&lt;b style=&quot;font-size:14px;&quot;&gt;BCNF (Boyce-Codd Normal Form)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, FirstName, LastName, Email, ...)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ Every determinant is a candidate key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Candidate Keys:&lt;br&gt;• AlumniID&lt;br&gt;• Email&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;font-weight:bold;&quot;&gt;ALUMNI is in BCNF ✓&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1580" y="120" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="3nf_to_bcnf" style="html=1;strokeWidth=2;strokeColor=#000000;endArrow=blockThin;startArrow=none;labelBackgroundColor=none;fontSize=10;fontStyle=1;fontColor=#CC0000;" edge="1" source="three_nf_alumni" target="bcnf_alumni" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="alumni_skill_norm" value="&lt;b style=&quot;font-size:14px;&quot;&gt;ALUMNI_SKILL (Junction Table)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI_SKILL&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, &lt;u&gt;SkillID&lt;/u&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Functional Dependencies:&lt;/b&gt;&lt;br&gt;(AlumniID, SkillID) → ∅&lt;br&gt;&lt;br&gt;&lt;b&gt;Candidate Key:&lt;/b&gt; (AlumniID, SkillID)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 1NF&lt;/b&gt; - Atomic values&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 2NF&lt;/b&gt; - No partial deps&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 3NF&lt;/b&gt; - No transitive deps&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ BCNF&lt;/b&gt; - Determinant is candidate key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="350" height="250" as="geometry"/></mxCell>
        <mxCell id="alumni_event_norm" value="&lt;b style=&quot;font-size:14px;&quot;&gt;ALUMNI_EVENT (Junction Table)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI_EVENT&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, &lt;u&gt;EventID&lt;/u&gt;, RegistrationDate)&lt;br&gt;&lt;br&gt;&lt;b&gt;Functional Dependencies:&lt;/b&gt;&lt;br&gt;(AlumniID, EventID) → RegistrationDate&lt;br&gt;&lt;br&gt;&lt;b&gt;Candidate Key:&lt;/b&gt; (AlumniID, EventID)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 1NF&lt;/b&gt; - Atomic values&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 2NF&lt;/b&gt; - Full key dependency&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 3NF&lt;/b&gt; - No transitive deps&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ BCNF&lt;/b&gt; - Determinant is candidate key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="450" y="400" width="350" height="250" as="geometry"/></mxCell>
        <mxCell id="alumni_phone_norm" value="&lt;b style=&quot;font-size:14px;&quot;&gt;ALUMNI_PHONE (Multivalued)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ALUMNI_PHONE&lt;/b&gt;(&lt;u&gt;AlumniID&lt;/u&gt;, &lt;u&gt;PhoneNumber&lt;/u&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Functional Dependencies:&lt;/b&gt;&lt;br&gt;(AlumniID, PhoneNumber) → ∅&lt;br&gt;&lt;br&gt;&lt;b&gt;Candidate Key:&lt;/b&gt; (AlumniID, PhoneNumber)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 1NF&lt;/b&gt; - Atomic values&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 2NF&lt;/b&gt; - No partial deps&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ 3NF&lt;/b&gt; - No transitive deps&lt;br&gt;&lt;b style=&quot;color:green;&quot;&gt;✓ BCNF&lt;/b&gt; - Determinant is candidate key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="850" y="400" width="350" height="250" as="geometry"/></mxCell>
        <mxCell id="summary" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Normalization Summary&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Table | 1NF | 2NF | 3NF | BCNF&lt;/b&gt;&lt;br&gt;──────────────────────────────────&lt;br&gt;DEPARTMENT | ✓ | ✓ | ✓ | ✓&lt;br&gt;BATCH | ✓ | ✓ | ✓ | ✓&lt;br&gt;COMPANY | ✓ | ✓ | ✓ | ✓&lt;br&gt;SKILL | ✓ | ✓ | ✓ | ✓&lt;br&gt;ALUMNI | ✓ | ✓ | ✓ | ✓&lt;br&gt;STUDENT | ✓ | ✓ | ✓ | ✓&lt;br&gt;EVENT | ✓ | ✓ | ✓ | ✓&lt;br&gt;DONATION | ✓ | ✓ | ✓ | ✓&lt;br&gt;JOB | ✓ | ✓ | ✓ | ✓&lt;br&gt;MENTORSHIP | ✓ | ✓ | ✓ | ✓&lt;br&gt;ALUMNI_SKILL | ✓ | ✓ | ✓ | ✓&lt;br&gt;ALUMNI_PHONE | ✓ | ✓ | ✓ | ✓&lt;br&gt;ALUMNI_EVENT | ✓ | ✓ | ✓ | ✓&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:green;font-weight:bold;&quot;&gt;All tables in BCNF ✓&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=10;verticalAlign=top;align=left;spacingLeft=5;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="50" y="720" width="400" height="350" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b style=&quot;font-size:14px;&quot;&gt;Normalization Forms&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;&lt;b style=&quot;background-color:#E8F4FD;&quot;&gt;1NF&lt;/b&gt; - No repeating groups, atomic values&lt;br&gt;&lt;br&gt;&lt;b style=&quot;background-color:#D5E8D4;&quot;&gt;2NF&lt;/b&gt; - No partial dependencies&lt;br&gt;&lt;br&gt;&lt;b style=&quot;background-color:#FFE6CC;&quot;&gt;3NF&lt;/b&gt; - No transitive dependencies&lt;br&gt;&lt;br&gt;&lt;b style=&quot;background-color:#F8CECC;&quot;&gt;BCNF&lt;/b&gt; - Every determinant is a candidate key&lt;br&gt;&lt;br&gt;&lt;b&gt;Key Concepts:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Partial Dependency:&lt;/b&gt; Non-key attr depends on part of key&lt;br&gt;• &lt;b&gt;Transitive Dependency:&lt;/b&gt; A→B→C (B depends on A, C depends on B)&lt;br&gt;• &lt;b&gt;Determinant:&lt;/b&gt; Attribute that determines other attributes&lt;br&gt;• &lt;b&gt;Candidate Key:&lt;/b&gt; Minimal superkey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="500" y="720" width="400" height="300" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>